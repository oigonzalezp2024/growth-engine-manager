# ==========================================
# CONFIGURACIÓN DE META ADS GRAPH API
# ==========================================

# Tu App ID de Meta for Developers
META_APP_ID=1234567890123456

# Tu App Secret de Meta Developers (No compartir ni subir a repositorios públicos)
META_APP_SECRET=a1b2c3d4e5f67890abcdef1234567890

# ID de la Cuenta Publicitaria de Meta (Debe incluir el prefijo 'act_')
META_AD_ACCOUNT_ID=act_123456789012345

# Access Token de Meta (System User Token o Long-Lived Token con permisos ads_read y read_insights)
META_ACCESS_TOKEN=EAAG...